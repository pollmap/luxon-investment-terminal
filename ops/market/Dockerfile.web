FROM node:24-slim AS builder
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.19.0 --activate
ENV pnpm_config_pm_on_fail=ignore
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/package.json
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY apps/web ./apps/web
ARG MARKET_API_BASE_URL=http://market-api:8210
ENV MARKET_API_BASE_URL=$MARKET_API_BASE_URL
ENV NODE_OPTIONS=--max-old-space-size=1536
RUN pnpm --filter @personal-fastgraphs/web build
# Preserve SWC runtime exports omitted by the standalone file tracer.
RUN cp -a node_modules/.pnpm/@swc+helpers@* apps/web/.next/standalone/node_modules/.pnpm/
FROM node:24-slim
WORKDIR /app
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3210
COPY --from=builder --chown=node:node /app/apps/web/.next/standalone ./
COPY --from=builder --chown=node:node /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=node:node /app/apps/web/public ./apps/web/public
RUN node -e "require('./apps/web/node_modules/next')"
USER node
CMD ["node", "apps/web/server.js"]
