# Public APIs and local SQLite work without secrets.
MARKET_UNIVERSE_INTERVAL=300
MARKET_FILINGS_INTERVAL=900
MARKET_HISTORY_INTERVAL=86400
# default: stop 90%/resume below 80%; approved extra-storage profile:
# high-utilization: stop 97% or <3GiB; resume below 95% and >=4GiB.
MARKET_STORAGE_PROFILE=default
MARKET_ENRICHMENT_BATCH=3
# OpenDART documents a general call-limit error around 20,000 requests; keep margin.
DART_DAILY_REQUEST_BUDGET=12000
# Set only for Docker/PostgreSQL; URL-safe random password.
MARKET_DB_PASSWORD=
MARKET_PUBLIC_ORIGIN=
# Optional server-side connectors. Never expose these through NEXT_PUBLIC_*.
DART_API_KEY=
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
