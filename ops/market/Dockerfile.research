FROM python:3.12-slim
WORKDIR /app
COPY ops/market/research-requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY services/__init__.py /app/services/__init__.py
COPY services/market_dashboard/__init__.py /app/services/market_dashboard/__init__.py
COPY services/market_dashboard/research_embeddings.py services/market_dashboard/research_worker.py /app/services/market_dashboard/
ENV MARKET_RESEARCH_BIND=0.0.0.0
USER 65532:65532
CMD ["python", "-m", "services.market_dashboard.research_worker"]
