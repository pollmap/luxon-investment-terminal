    "template:consensus": "python -m services.ingestion_worker.cli export-consensus-template --tickers 005930.KS,000660.KS,402340.KS,005380.KS,028260.KS,032830.KS,373220.KS,207940.KS,329180.KS,009155.KS --cases median --out storage/imports/consensus_estimates.csv",
    "validate:consensus": "python -m services.ingestion_worker.cli validate-consensus-csv --path storage/imports/consensus_estimates.csv --tickers 005930.KS,000660.KS,402340.KS,005380.KS,028260.KS,032830.KS,373220.KS,207940.KS,329180.KS,009155.KS --cases median,current --case-mode any --strict",
    "secret:audit": "python -m services.ingestion_worker.cli secret-audit --strict",
    "deploy:gate:kr:005930": "python -m services.ingestion_worker.cli deploy-gate --markets KR --tickers 005930.KS --require-blob --require-consensus-forecast --summary-only --strict",
    "deploy:gate": "python -m services.ingestion_worker.cli deploy-gate --markets KR --tickers 005930.KS,000660.KS,402340.KS,005380.KS,028260.KS,032830.KS,373220.KS,207940.KS,329180.KS,009155.KS --require-blob --require-consensus-forecast --summary-only --strict",
    "verify": "pnpm preflight && python -m pytest && pnpm build",
    "vercel:build": "vercel build",
    "blob:sync": "node scripts/blob-sync.mjs",
    "blob:sync:dry-run": "node scripts/blob-sync.mjs --dry-run",
    "smoke:api": "node scripts/deploy-smoke.mjs",
    "smoke:api:kr": "node scripts/deploy-smoke.mjs --ticker 005930.KS --require-consensus-forecast --require-kr-top10-production-gate",
    "smoke:api:kr:partial": "node scripts/deploy-smoke.mjs --ticker 005930.KS --require-kr-top10-partial-audit",
    "workflow:kr:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-kr-production-smoke.ps1"
