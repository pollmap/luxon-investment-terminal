    "load:valuation-postgres:kr:top10": "python -m services.ingestion_worker.cli load-kr-valuation-postgres --tickers 005930.KS,000660.KS,402340.KS,005380.KS,028260.KS,032830.KS,373220.KS,207940.KS,329180.KS,009155.KS --strict",
    "load:valuation-postgres:kr:top10:dry-run": "python -m services.ingestion_worker.cli load-kr-valuation-postgres --tickers 005930.KS,000660.KS,402340.KS,005380.KS,028260.KS,032830.KS,373220.KS,207940.KS,329180.KS,009155.KS --dry-run --strict",
