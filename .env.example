# Required only when US ingestion is selected.
SEC_USER_AGENT="LUXON/0.1 your-email@example.com"

# Docker Compose local beta. Replace the password before first start.
POSTGRES_PASSWORD="change-me-before-first-start"
LUXON_WEB_PORT="3100"
LUXON_API_PORT="8000"
LUXON_DB_PORT="5432"

# Vercel/Neon deployment. KR E2E persistence requires DATA_BACKEND=postgres
# and DATABASE_URL. The fixture backend is for local UI/demo work only.
NEXT_PUBLIC_SITE_URL="http://localhost:3100"
DATABASE_URL="postgresql+psycopg://user:password@host/db?sslmode=require"
BLOB_READ_WRITE_TOKEN=""
DATA_BACKEND="fixture"
ALLOW_FIXTURE_FALLBACK="false"
CHART_CACHE_DIR=""
CHART_RUN_DIR=""
CHART_LAYOUT_DIR=""
CHART_BLOB_QUEUE_ENABLED="false"

# Private terminal auth. Set AUTH_REQUIRED=true in Vercel production.
AUTH_REQUIRED="false"
AUTH_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_ALLOWED_EMAILS="you@example.com"
PF_COOKIE_SECRET=""
API_AUTH_REQUIRED="false"
API_AUTH_DISABLED="true"
API_CORS_ORIGINS="http://localhost:3100,http://127.0.0.1:3100"
API_RATE_LIMIT_ENABLED="false"
API_RATE_LIMIT_REQUESTS="600"
API_RATE_LIMIT_WINDOW_SECONDS="60"
API_RATE_LIMIT_EXEMPT_PATHS="/api/health"
API_ENABLE_HSTS="false"

# KR-first live ingestion requires one of OPENDART_API_KEY or DART_API_KEY.
OPENDART_API_KEY=""
# Alias accepted for OpenDART if your secret manager uses DART_API_KEY.
DART_API_KEY=""

# JP ingestion is a later slice.
EDINET_API_KEY=""
JQUANTS_EMAIL=""
JQUANTS_PASSWORD=""
JQUANTS_REFRESH_TOKEN=""

# Macro/rates/FX/recession overlays.
FRED_API_KEY=""

# KR/JP official macro and industry statistics. Curate table IDs before running.
ECOS_API_KEY=""
KOSIS_API_KEY=""
ESTAT_APP_ID=""

# Local-only API config.
API_BASE_URL="http://127.0.0.1:8000"
SQLITE_PATH="data/app.sqlite"
DUCKDB_PATH="data/warehouse/warehouse.duckdb"
